# D2RM Dashboard SaaS — environment template.
# Copy to .env and fill in. Never commit .env.

# Port to listen on (default 3000)
PORT=3000

# NODE_ENV: development | test | production
# production => Secure cookies, APP_BASE_URL required, dev token echoes off
NODE_ENV=development

# SQLite file (default: <project>/data/d2rm-dashboard.db)
DATABASE_PATH=

# Public base URL of this app — REQUIRED in production.
# Used in emailed verification / password-reset links. Must be https://.
APP_BASE_URL=https://dashboard.example.com

# Dashboard template served at /app (default: ~/workspace/your_files/d2rm-live-dashboard.html)
DASHBOARD_HTML_PATH=

# AI co-pilot: set to enable Muse synthesis. Unset => built-in insight engine.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5

# --- Scribe: Meta Muse Spark via the Meta Model API (OpenAI-compatible) ---
# Scribe is Manna's performance analyst (observations + recommendations +
# draft artifacts). SPARK_API_KEY is the ONLY value it needs.
# UNSET => STUB MODE: the full Scribe pipeline runs and returns clearly
# marked SAMPLE output; no network call is made. Set the key and restart
# to go live — no code change. SPARK_BASE_URL / SPARK_MODEL only need
# setting if Meta's production values differ from these defaults;
# confirm them when the key is issued.
SPARK_API_KEY=
# SPARK_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3

# --- Video generation: HeyGen API (pay-as-you-go) ---
# HEYGEN_API_KEY is the ONLY value video generation needs.
# UNSET => FAIL CLOSED: the video endpoints answer 503
# heygen_not_configured and no video is ever faked. Set the key and
# restart to go live — no code change. Optional pins for the exact
# provider avatar/voice ids behind the dashboard catalogue (otherwise
# the provider's own avatar/voice lists are mapped in catalogue order):
# HEYGEN_API_BASE=https://api.heygen.com
# HEYGEN_AVATAR_PRESENTER_A=
# HEYGEN_AVATAR_PRESENTER_B=
# HEYGEN_AVATAR_PRESENTER_C=
# HEYGEN_VOICE_NARRATOR_WARM=
# HEYGEN_VOICE_NARRATOR_BRIGHT=
# HEYGEN_VOICE_NARRATOR_CALM=
HEYGEN_API_KEY=

# Social token encryption: 64 hex chars (32 bytes). REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it (dev/test only), an ephemeral key is used and tokens won't
# survive a restart.
SOCIAL_TOKEN_KEY=

# --- Meta (Facebook + Instagram) OAuth: auto-posting from Manna ---
# Create an app at https://developers.facebook.com/apps, add the
# "Facebook Login" product, and register FACEBOOK_REDIRECT_URI as a
# Valid OAuth Redirect URI. Scopes requested: pages_show_list,
# pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish. Page tokens are AES-256-GCM encrypted
# (SOCIAL_TOKEN_KEY) before storage. Never commit real credentials.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=<redacted>
# FACEBOOK_REDIRECT_URI=https://your-app.onrender.com/api/facebook/callback

# --- Later: Stripe (stubbed in this build) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FaithShield subscription tracking webhook (POST /api/billing/webhook/faithshield).
# Dedicated signing secret for that endpoint; unset = endpoint refuses (503).
# STRIPE_FS_WEBHOOK_SECRET=
# FaithShield price in the shared Stripe account (default shown; override only if it changes).
# STRIPE_FS_PRICE_ID=price_1UQtKcHKZQIpdYgs
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=

# --- Amazon SES: transactional email (verification, password reset) ---
# When AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + SES_FROM_EMAIL are all
# set, mailer.js sends via SES. If any is missing, it falls back to the
# stub (logs + in-memory outbox, zero emails sent).
# ALL THREE are REQUIRED in production (server refuses to boot without them).
# NOTE: new SES accounts start in the SANDBOX (verified identities only).
# Request production access in the SES console before launch, and verify
# SES_FROM_EMAIL (or its domain) in the same AWS_REGION.
# SES pricing: $0.10 per 1,000 emails after the free tier.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@example.com
